{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git restore *)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)"
    ]
  }
}
